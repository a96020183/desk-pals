<?xml version="1.0" encoding="utf-8"?>
<!--
  公仔櫃 Desk Pals：Microsoft Store（MSIX）套件資訊清單。packaging\windows\build.ps1 會把 __XXX__ 換掉。

  ★ 上架前要填的三個值（Partner Center → 你的 App → 產品管理 → 產品身分識別 Product identity）：
      __IDENTITY_NAME__            → Package/Identity/Name                 GitHub 變數 MSIX_IDENTITY_NAME
      __PUBLISHER__                → Package/Identity/Publisher            GitHub 變數 MSIX_PUBLISHER（形如 CN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX）
      __PUBLISHER_DISPLAY_NAME__   → Package/Properties/PublisherDisplayName  GitHub 變數 MSIX_PUBLISHER_DISPLAY_NAME
    沒填＝佔位值（DeskPals.Placeholder／CN=DeskPals-Placeholder），只能拿來檢查，Partner Center 不收。
  ★ DisplayName「公仔櫃 Desk Pals」要跟你在 Partner Center 保留的 App 名稱一模一樣（保留的名字不同就改這裡兩處）。
  __VERSION__ 由 extension/package.json 的 version 產生（x.y.z.0；Store 規定最後一碼是 0）。

  刻意「不」宣告 unvirtualizedResources／FileSystemWriteVirtualization=disabled（受限功能，Store 很少核准、會影響乾淨解除安裝）：
  Store 版在 %LOCALAPPDATA%\DeskPals 新建的檔案會放進自己的私人資料夾（解除安裝時一起清掉）；本來就有的檔案（VS Code 擴充套件那份）
  讀得到、改了會改原檔。pipe 不受影響，VS Code 照樣連得上（擴充套件看 %LOCALAPPDATA%\Microsoft\WindowsApps\DeskPals.exe
  這個執行別名判斷「裝了 Store 版」）。詳見 DeskPals.Main.cs 的 Packaged。
  受限功能只剩 runFullTrust（傳統桌面程式都要；送審時寫理由）。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64"/>

  <Properties>
    <DisplayName>公仔櫃 Desk Pals</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>

  <Resources>
    <Resource Language="zh-TW"/>
  </Resources>

  <Applications>
    <Application Id="DeskPals" Executable="DeskPals.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="公仔櫃 Desk Pals"
        Description="桌面上的像素公仔櫃：選一隻出來，在整個螢幕陪你。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png" ShortName="公仔櫃"/>
      </uap:VisualElements>
      <Extensions>
        <!-- 開機自動啟動：第一次打開後生效。第一次設定的第二頁有「開機時自動出現」勾選（沒勾＝StartupTask.Disable），
             之後小屋選單、Windows「設定 → 應用程式 → 啟動」都能開關 -->
        <desktop:Extension Category="windows.startupTask" Executable="DeskPals.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeskPalsStartup" Enabled="true" DisplayName="公仔櫃 Desk Pals"/>
        </desktop:Extension>
        <!-- %LOCALAPPDATA%\Microsoft\WindowsApps\DeskPals.exe：VS Code 擴充套件用這個路徑叫它起來 -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="DeskPals.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="DeskPals.exe"/>
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient"/>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
