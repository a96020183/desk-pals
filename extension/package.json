{
	"name": "desk-pals",
	"displayName": "公仔櫃 Desk Pals",
	"description": "大學生桌面小夥伴：皮克敏陪你專注、喝水、安排課業與搶票提醒，也能使用 OpenAI API 聊聊。",
	"version": "0.7.0",
	"publisher": "local",
	"engines": {
		"vscode": "^1.70.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "deskPals",
					"title": "公仔櫃",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"deskPals": [
				{
					"type": "webview",
					"id": "deskPals.view",
					"name": "公仔櫃",
					"visibility": "visible"
				}
			]
		},
		"commands": [
			{
				"command": "deskPals.aiSetup",
				"title": "公仔櫃：設定 AI 皮克敏（API 金鑰）"
			},
			{
				"command": "deskPals.pick",
				"title": "公仔櫃：換角色"
			},
			{
				"command": "deskPals.lineup",
				"title": "公仔櫃：換一櫃（經典／天線寶寶／皮克敏）"
			},
			{
				"command": "deskPals.remind",
				"title": "公仔櫃：提醒我…"
			},
			{
				"command": "deskPals.ticket",
				"title": "公仔櫃：搶票提醒 🎫"
			},
			{
				"command": "deskPals.all",
				"title": "公仔櫃：全部放出來（會串門子）"
			},
			{
				"command": "deskPals.home",
				"title": "公仔櫃：全部回櫃子"
			},
			{
				"command": "deskPals.show",
				"title": "公仔櫃：叫他出來（側邊欄）"
			},
			{
				"command": "deskPals.hi",
				"title": "公仔櫃：打招呼"
			},
			{
				"command": "deskPals.hug",
				"title": "公仔櫃：抱抱"
			},
			{
				"command": "deskPals.knock",
				"title": "公仔櫃：敲敲螢幕"
			},
			{
				"command": "deskPals.ball",
				"title": "公仔櫃：丟球給他"
			},
			{
				"command": "deskPals.hide",
				"title": "公仔櫃：躲起來／出來（Ctrl+Alt+S）"
			},
			{
				"command": "deskPals.bond",
				"title": "公仔櫃：我們的感情（好感度）"
			},
			{
				"command": "deskPals.desktopOn",
				"title": "公仔櫃：放他到整個螢幕（開機自動出現）"
			},
			{
				"command": "deskPals.desktopOff",
				"title": "公仔櫃：收工（關掉整個螢幕版）"
			},
			{
				"command": "deskPals.restNow",
				"title": "公仔櫃：測試休息提醒"
			},
			{
				"command": "deskPals.focus",
				"title": "公仔櫃：專注 25 分鐘 🍅"
			},
			{
				"command": "deskPals.focusStop",
				"title": "公仔櫃：結束專注"
			},
			{
				"command": "deskPals.jiraSetup",
				"title": "公仔櫃：設定 Jira（新單指派給你時通知）"
			},
			{
				"command": "deskPals.quiet30",
				"title": "公仔櫃：安靜 30 分鐘"
			},
			{
				"command": "deskPals.quiet120",
				"title": "公仔櫃：安靜 2 小時"
			},
			{
				"command": "deskPals.quietOff",
				"title": "公仔櫃：結束安靜"
			}
		],
		"configuration": {
			"title": "公仔櫃 Desk Pals",
			"properties": {
				"deskPals.character": {
					"type": "string",
					"default": "spidey",
					"enum": [
						"spidey",
						"po",
						"stitch",
						"hangyodon",
						"tinky",
						"dipsy",
						"laalaa",
						"pkred",
						"pkyellow",
						"pkblue"
					],
					"enumDescriptions": [
						"Spidey（像素小蜘蛛人）",
						"小波（騎滑板車；兩櫃都有）",
						"史迪仔",
						"人魚漢頓",
						"丁丁（天線寶寶一櫃）",
						"迪西（天線寶寶一櫃）",
						"拉拉（天線寶寶一櫃）",
						"紅皮克敏（皮克敏一櫃）",
						"黃皮克敏（皮克敏一櫃）",
						"藍皮克敏（皮克敏一櫃）"
					],
					"description": "第一次放出來的公仔（之後在桌面點公仔櫃換角色，會記住你上次選的）"
				},
				"deskPals.lineup": {
					"type": "string",
					"default": "classic",
					"enum": [
						"classic",
						"teletubbies",
						"pikmin"
					],
					"enumDescriptions": [
						"經典一櫃：Spidey、小波、史迪仔、人魚漢頓",
						"天線寶寶一櫃：丁丁、迪西、拉拉、小波（大格是小波）",
						"皮克敏一櫃：紅、黃、藍皮克敏（大格是休息花：用電腦太久花會枯，休息回來才開）"
					],
					"description": "公仔櫃裡放哪一櫃公仔（Windows）。改了會當場換；也可以用指令「公仔櫃：換一櫃」"
				},
				"deskPals.desktop": {
					"type": "boolean",
					"default": true,
					"description": "整個螢幕版：不限 VS Code，整台電腦都有他，開機自動出現（Windows／macOS）"
				},
				"deskPals.birthday": {
					"type": "string",
					"default": "",
					"pattern": "^(\\d{2}-\\d{2})?$",
					"description": "你的生日（MM-DD，例如 03-15），當天 公仔 會捧蛋糕"
				},
				"deskPals.restMinutes": {
					"type": "number",
					"default": 50,
					"description": "連續用幾分鐘後提醒休息"
				},
				"deskPals.idleMinutes": {
					"type": "number",
					"default": 5,
					"description": "幾分鐘沒動作，公仔 就去睡覺（休息計時也會歸零）"
				},
				"deskPals.focusMinutes": {
					"type": "number",
					"default": 25,
					"description": "番茄鐘專注幾分鐘"
				},
				"deskPals.calendarIcsUrl": {
					"type": "string",
					"default": "",
					"description": "行事曆的 ICS 私人網址（Google 日曆：設定 → 你的日曆 → 「iCal 格式的私人網址」；Outlook：發佈行事曆的 ICS 連結）。填了就會在開會前提醒你。"
				},
				"deskPals.meetingRemindMinutes": {
					"type": "number",
					"default": 5,
					"description": "開會前幾分鐘提醒"
				},
				"deskPals.jira.site": {
					"type": "string",
					"default": "",
					"description": "Jira 網站（例如 yourteam.atlassian.net）；建議用「公仔櫃：設定 Jira」指令設定"
				},
				"deskPals.jira.email": {
					"type": "string",
					"default": "",
					"description": "Jira 登入信箱"
				},
				"deskPals.jira.credentialsFile": {
					"type": "string",
					"default": "",
					"description": "（進階）改從這個 JSON 檔讀 Jira 憑證：{\"site\",\"email\",\"api_token\"}"
				},
				"deskPals.worklogDir": {
					"type": "string",
					"default": "",
					"description": "工作日誌資料夾：裡面出現今天的新檔時，公仔會通知你（點他就打開）"
				},
				"deskPals.meetingAutoQuiet": {
					"type": "boolean",
					"default": true,
					"description": "開會時自動安靜到會議結束（要先填行事曆網址）"
				},
				"deskPals.weatherLocation": {
					"type": "string",
					"default": "",
					"description": "下雨提醒的地點（城市名，例如「台北」，或「緯度,經度」）。平日 17:30 會看等一下下班和明天會不會下雨（Open-Meteo 免費天氣資料）。"
				},
				"deskPals.gitlabHosts": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "要看 GitLab 待辦的主機（需要先用 glab 登入），例如 gitlab.com。有人請你 review、指派 MR、@你、pipeline 失敗時通知你。"
				},
				"deskPals.companyHost": {
					"type": "string",
					"default": "",
					"description": "公司內部主機（例如公司 GitLab 的網域）：網路正常但連不到它時，公仔會提醒你「連不到公司網路（VPN 斷了？）」"
				}
			}
		}
	}
}
